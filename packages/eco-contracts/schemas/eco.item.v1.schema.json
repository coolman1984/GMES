{
  "$id": "https://eco.local/contracts/eco.item.v1.schema.json",
  "title": "eco.item.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "en",
        "ar"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "app",
        "type",
        "key"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "product",
        "service"
      ]
    },
    "stock_tracked": {
      "type": "boolean"
    },
    "tracking": {
      "type": "string",
      "enum": [
        "none",
        "lot",
        "serial"
      ]
    },
    "base_uom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "units": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "factor": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "factor"
        ]
      }
    }
  },
  "required": [
    "id",
    "code",
    "name",
    "active",
    "version",
    "origin",
    "kind",
    "stock_tracked",
    "tracking",
    "base_uom",
    "units"
  ]
}
