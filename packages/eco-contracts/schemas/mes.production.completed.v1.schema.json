{
  "$id": "https://eco.local/contracts/mes.production.completed.v1.schema.json",
  "title": "mes.production.completed.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "work_order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "item": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "code"
          ]
        },
        "planned_qty": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,3}0*)?$"
        },
        "completed_qty_after": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,3}0*)?$"
        },
        "scrapped_qty": {
          "type": "string"
        },
        "is_final": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "code",
        "item",
        "planned_qty",
        "completed_qty_after",
        "scrapped_qty",
        "is_final"
      ]
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "qty": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,3}0*)?$"
    },
    "uom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "warehouse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "lot_no": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "production_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "shift": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "station": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "performed_by": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "person": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "code"
          ]
        }
      },
      "required": [
        "user"
      ]
    },
    "ledger_seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "work_order",
    "item",
    "qty",
    "uom",
    "warehouse",
    "production_date",
    "performed_by",
    "ledger_seq"
  ]
}
