{
  "$id": "https://eco.local/contracts/acc.goods_receipt.v1.schema.json",
  "title": "acc.goods_receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "app",
        "type",
        "key"
      ]
    },
    "purchase_order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "supplier": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "receipt_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "warehouse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "code"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "posted",
        "voided"
      ]
    },
    "lines": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_no": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "item": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "id",
              "code"
            ]
          },
          "qty": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,3}0*)?$"
          },
          "uom": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "lot_no": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "supplier_lot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "expiry": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "po_line_no": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "line_no",
          "item",
          "qty",
          "uom"
        ]
      }
    }
  },
  "required": [
    "id",
    "code",
    "version",
    "origin",
    "supplier",
    "receipt_date",
    "warehouse",
    "status",
    "lines"
  ]
}
